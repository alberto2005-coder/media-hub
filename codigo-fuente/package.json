{
  "name": "media-hub",
  "version": "1.0.0",
  "description": "Centro de entretenimiento personal, gratuito y legal",
  "main": "electron/main.js",
  "author": "Media Hub",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "npx --yes serve web -l 8080",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win-dir": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.mediahub.app",
    "productName": "Media Hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "web/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "MediaHub-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "hls.js": "^1.7.4"
  }
}
