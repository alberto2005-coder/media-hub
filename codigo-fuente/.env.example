# Claves gratuitas de Media Hub.
# Copia este archivo como ".env" y ponlo JUNTO al .exe (o en la raíz del proyecto si usas "npm start").
# Todas son opcionales: sin ellas la app funciona con Internet Archive, Audius, radio y podcasts.

# TMDB (catálogo de películas y series + dónde verlas): https://www.themoviedb.org/settings/api
# Vale la "Clave de API" o el "Token de acceso de lectura de la API".
TMDB_API_KEY=

# Jamendo (música libre, uso no comercial): https://devportal.jamendo.com
JAMENDO_CLIENT_ID=
