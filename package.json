{
  "name": "media-hub",
  "version": "1.0.0",
  "allowScripts": {
    "electron": true
  },
  "description": "Media Hub Portable",
  "author": "Alberto (alberto2005-coder)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "release": "electron-builder -p always"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mediahub.app",
    "productName": "MediaHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MediaHub-${version}-portable.exe"
    }
  }
}
