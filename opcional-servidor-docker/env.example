# Zona horaria
TZ=Europe/Madrid

# Carpeta con tu contenido. Relativa = funciona en Windows, macOS y Linux.
# Si prefieres otra ubicación (por ejemplo un disco externo), usa una ruta absoluta:
#   Windows: MEDIA_PATH=D:/Media
#   macOS:   MEDIA_PATH=/Users/tuusuario/Media
#   Linux:   MEDIA_PATH=/home/tuusuario/Media
MEDIA_PATH=./Media
